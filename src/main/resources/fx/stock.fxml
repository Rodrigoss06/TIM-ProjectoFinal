<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupob.inventario.ui.fx.controller.StockController"
      spacing="16" style="-fx-padding: 24; -fx-min-width: 340;">
  <Label text="Actualizar Stock" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
  <Label fx:id="infoProducto" wrapText="true"
         style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-background-radius: 6;"/>
  <HBox spacing="20">
    <fx:define><ToggleGroup fx:id="tipoGrupo"/></fx:define>
    <RadioButton fx:id="radioEntrada" text="Entrada" toggleGroup="$tipoGrupo" selected="true"/>
    <RadioButton fx:id="radioSalida"  text="Salida"  toggleGroup="$tipoGrupo"/>
  </HBox>
  <HBox spacing="12" alignment="CENTER_LEFT">
    <Label text="Cantidad:"/>
    <TextField fx:id="cantidad" promptText="1" prefWidth="120"/>
  </HBox>
  <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>
  <HBox spacing="10" alignment="CENTER_RIGHT">
    <Button fx:id="confirmarBtn" text="Confirmar" onAction="#confirmar"
            styleClass="boton-principal" defaultButton="true"/>
    <Button text="Cancelar" onAction="#cancelar" styleClass="boton-secundario" cancelButton="true"/>
  </HBox>
</VBox>
