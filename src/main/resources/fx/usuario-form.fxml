<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupob.inventario.ui.fx.controller.UsuarioFormController"
      spacing="16" style="-fx-padding: 24; -fx-min-width: 360;">

    <Label text="Nuevo Usuario" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints prefWidth="120" minWidth="100"/>
            <ColumnConstraints prefWidth="210" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Username *"     GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="username"  GridPane.rowIndex="0" GridPane.columnIndex="1"
                   promptText="Ej: gestor1"/>

        <Label text="Contraseña *"      GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="password" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       promptText="Min. 8 caracteres"/>

        <Label text="Confirmar *"            GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordConfirm" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       promptText="Repetir contrasena"/>

        <Label text="Rol *"         GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="rolCombo"  GridPane.rowIndex="3" GridPane.columnIndex="1"
                  maxWidth="Infinity"/>
    </GridPane>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"
           visible="false" managed="false" maxWidth="340"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="guardarBtn" text="Guardar" onAction="#guardar"
                styleClass="boton-principal" defaultButton="true"/>
        <Button text="Cancelar" onAction="#cancelar"
                styleClass="boton-secundario" cancelButton="true"/>
    </HBox>

</VBox>
