<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">

    <persistence-unit name="inventario-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.grupob.inventario.domain.model.Producto</class>
        <class>com.grupob.inventario.domain.model.Usuario</class>
        <class>com.grupob.inventario.domain.model.Movimiento</class>
        <class>com.grupob.inventario.domain.model.EventoAuditoria</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <!--
          Las properties de conexión (URL, usuario, password, pool) NO van aquí:
          las inyecta EntityManagerFactoryProvider en runtime desde Configuracion.
          hbm2ddl.auto=validate: Flyway controla el schema, Hibernate solo valida.
        -->
    </persistence-unit>
</persistence>
